<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web Remote" android:textSize="26sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aplikasi ini selalu menampilkan notifikasi saat layanan remote aktif." android:layout_marginTop="8dp"/>
<EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://nama-proyek.vercel.app" android:inputType="textUri" android:layout_marginTop="16dp"/>
<EditText android:id="@+id/pairToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="REMOTE_PAIR_TOKEN" android:inputType="textPassword"/>
<EditText android:id="@+id/deviceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nama perangkat"/>
<Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hubungkan dan mulai remote"/>
<Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stop remote"/>
<Button android:id="@+id/adminButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aktifkan Device Admin untuk Screen Off"/>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Status: belum aktif" android:layout_marginTop="12dp"/>
</LinearLayout></ScrollView>